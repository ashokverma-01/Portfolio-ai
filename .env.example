NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=portfolio
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or set CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET separately.
CLOUDINARY_FOLDER=studio_portfolio_uploads
GATEWAY_PORT=3000
PORTFOLIO_SERVICE_PORT=5001
CONTACT_SERVICE_PORT=5002
MEDIA_SERVICE_PORT=5003
ADMIN_API_KEY=replace_with_a_long_random_value
